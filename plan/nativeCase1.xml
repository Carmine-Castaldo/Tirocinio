<root BTCPP_format="4" main_tree_to_execute="MainTree1">

<BehaviorTree ID="MainTree1">
  <Sequence>
    <RunOnce>
      <Script code="mu_t1_1 := 2.0; mu_t1_2 := 1.0; mu_t1_3 := 1.0; mu_t1_4 := 1.0;
                    mu_t2_1 := 2.0; mu_t2_2 := 1.0; mu_t2_3 := 1.0; mu_t2_4 := 1.0;
                    done_yellow := false; done_orange := false; done_green := false; done_red := false;
                    placed_yellow := false; placed_orange := false; placed_green := false; placed_red := false;
                    phase_take := 0.0;  phase_return := 1.0"/>
    </RunOnce>

    <Parallel failure_count="1" success_count="2">
      <SubTree ID="Task1" _autoremap="true" />
      <SubTree ID="Task2" _autoremap="true" />
    </Parallel>
  </Sequence>
</BehaviorTree>

<BehaviorTree ID="Task1">
  <Parallel failure_count="4" success_count="4">
    <SubTree ID="Take"   Object="/YellowCube" Color="Yellow" X="{YellowCube_x}" Y="{YellowCube_y}"
             Done="{done_yellow}" Placed="{placed_yellow}" Phase="{phase_take}"
             mu="{mu_t1_1}" _autoremap="true" _onSuccess="mu_t1_2 := mu_t1_2 + 1.0" />
    <SubTree ID="Take"   Object="/OrangeCube" Color="Orange" X="{OrangeCube_x}" Y="{OrangeCube_y}"
             Done="{done_orange}" Placed="{placed_orange}" Phase="{phase_take}"
             mu="{mu_t1_2}" _autoremap="true" _onSuccess="mu_t1_3 := mu_t1_3 + 1.0" />
    <SubTree ID="Return" Object="/YellowCube" Color="Yellow" X="{Bill_x}" Y="{Bill_y}"
             Done="{done_yellow}" Placed="{placed_yellow}" Phase="{phase_return}"
             mu="{mu_t1_3}" _autoremap="true" _onSuccess="mu_t1_4 := mu_t1_4 + 1.0" />
    <SubTree ID="Return" Object="/OrangeCube" Color="Orange" X="{Bill_x}" Y="{Bill_y}"
             Done="{done_orange}" Placed="{placed_orange}" Phase="{phase_return}"
             mu="{mu_t1_4}" _autoremap="true" />
  </Parallel>
</BehaviorTree>

<BehaviorTree ID="Task2">
  <Parallel failure_count="4" success_count="4">
    <SubTree ID="Take"   Object="/GreenCube" Color="Green" X="{GreenCube_x}" Y="{GreenCube_y}"
             Done="{done_green}" Placed="{placed_green}" Phase="{phase_take}"
             mu="{mu_t2_1}" _autoremap="true" _onSuccess="mu_t2_2 := mu_t2_2 + 1.0" />
    <SubTree ID="Take"   Object="/RedCube" Color="Red" X="{RedCube_x}" Y="{RedCube_y}"
             Done="{done_red}" Placed="{placed_red}" Phase="{phase_take}"
             mu="{mu_t2_2}" _autoremap="true" _onSuccess="mu_t2_3 := mu_t2_3 + 1.0" />
    <SubTree ID="Return" Object="/GreenCube" Color="Green" X="{Bill_x}" Y="{Bill_y}"
             Done="{done_green}" Placed="{placed_green}" Phase="{phase_return}"
             mu="{mu_t2_3}" _autoremap="true" _onSuccess="mu_t2_4 := mu_t2_4 + 1.0" />
    <SubTree ID="Return" Object="/RedCube" Color="Red" X="{Bill_x}" Y="{Bill_y}"
             Done="{done_red}" Placed="{placed_red}" Phase="{phase_return}"
             mu="{mu_t2_4}" _autoremap="true" />
  </Parallel>
</BehaviorTree>

<BehaviorTree ID="Take">
  <Sequence>
    <SubTree ID="GoToColor" _autoremap="true"/>
    <SubTree ID="PickUp"    _autoremap="true"/>
  </Sequence>
</BehaviorTree>

<BehaviorTree ID="GoToColor">
  <SubTree ID="GoToObject" _autoremap="true"/>    
</BehaviorTree>

<BehaviorTree ID="GoToObject">
  <Parallel failure_count="2" success_count="1">
    <SubTree ID="FollowColor" _autoremap="true"/>
    <ForceFailure>
      <SubTree ID="ExploreXY" _autoremap="true"/>
    </ForceFailure>
  </Parallel>
</BehaviorTree>

<BehaviorTree ID="FollowColor">
  <Parallel failure_count="1" success_count="1">

    <ReactiveSequence>
      <RunOnce> <Script code="_stimuli_avoid := 1.0"/> </RunOnce>
      <Script code="_lambda_avoid := (_stimuli_avoid <= 0.5) ? 0.01 : ((_stimuli_avoid >= 1.0) ? 1.0 : (0.01 + 0.99*(_stimuli_avoid - 0.5)/(1.0 - 0.5)));
                    _e_avoid := 1.0 / _lambda_avoid;
                    _p_avoid := 0.1" />
      <AvoidObstacles name="avoid" Object="{Object}" lambda="{_lambda_avoid}" emphasis="{_e_avoid}" period="{_p_avoid}" stimuli="{_stimuli_avoid}" />
    </ReactiveSequence>

    <ReactiveSequence>
      <RunOnce> <Script code="_stimuli_reach := 10.0"/> </RunOnce>
      <Script code="_lambda_reach := (_stimuli_reach <= 1.0) ? 0.01 : ((_stimuli_reach >= 10.0) ? 1.0 : (0.01 + 0.99*(_stimuli_reach - 1.0)/(10.0 - 1.0)));
                    _e_reach := mu / _lambda_reach;
                    _p_reach := 1.0 / _e_reach;
                    _ext_reach := (Done == Phase) && !Placed" />
      <ReachColor name="ReachColor" Color="{Color}" Object="{Object}" stimuli="{_stimuli_reach}"
                  mu="{mu}" lambda="{_lambda_reach}" emphasis="{_e_reach}" period="{_p_reach}"
                  external="{_ext_reach}"
                  _onSuccess="mu := mu + 1.0" />
    </ReactiveSequence>

  </Parallel>
</BehaviorTree>

<BehaviorTree ID="ExploreXY">
  <Parallel failure_count="1" success_count="1">

    <ReactiveSequence>
      <RunOnce> <Script code="_stimuli_avoid := 1.0"/> </RunOnce>
      <Script code="_lambda_avoid_xy := (_stimuli_avoid <= 0.5) ? 0.01 : ((_stimuli_avoid >= 1.0) ? 1.0 : (0.01 + 0.99*(_stimuli_avoid - 0.5)/(1.0 - 0.5)));
                    _e_avoid_xy := 1.0 / _lambda_avoid_xy;
                    _p_avoid_xy := 0.1" />
      <AvoidObstacles name="avoid" Object="{Object}" lambda="{_lambda_avoid_xy}" emphasis="{_e_avoid_xy}" period="{_p_avoid_xy}" stimuli="{_stimuli_avoid}" />
    </ReactiveSequence>

    <ReactiveSequence>
      <RunOnce> <Script code="_stimuli_xy := 10.0"/> </RunOnce>
      <Script code="_lambda_xy := (_stimuli_xy <= 1.0) ? 0.01 : ((_stimuli_xy >= 10.0) ? 1.0 : (0.01 + 0.99*(_stimuli_xy - 1.0)/(10.0 - 1.0)));
                    _e_xy := mu / _lambda_xy;
                    _p_xy := 1.0 / _e_xy;
                    _ext_xy := (Done == Phase) && !Placed" />
      <GoToXY name="GoToXY" X="{X}" Y="{Y}" Object="{Object}" stimuli="{_stimuli_xy}"
              mu="{mu}" lambda="{_lambda_xy}" emphasis="{_e_xy}" period="{_p_xy}"
              external="{_ext_xy}"
              _onSuccess="mu := mu + 1.0" />
    </ReactiveSequence>

    <ReactiveSequence>
      <Script code="_lambda_wander := 1.0;
                    _e_wander := 1.0 / _lambda_wander;
                    _p_wander := 1.0 / _e_wander" />
      <Wander name="wander" lambda="{_lambda_wander}" emphasis="{_e_wander}" period="{_p_wander}" />
    </ReactiveSequence>

  </Parallel>
</BehaviorTree>

<BehaviorTree ID="PickUp">
  <ReactiveSequence>
    <RunOnce> <Script code="_stimuli_pick := 1.0"/> </RunOnce>
    <Script code="_lambda_pick := (_stimuli_pick <= 0.5) ? 0.01 : ((_stimuli_pick >= 1.0) ? 1.0 : (0.01 + 0.99*(_stimuli_pick - 0.5)/(1.0 - 0.5)));
                  _e_pick := mu / _lambda_pick;
                  _p_pick := 1.0 / _e_pick;
                  _ext_pick := !Done && !Placed" />
    <Place Object="{Object}" Target="knapsack" knapsack="{knapsack}" stimuli="{_stimuli_pick}"
           mu="{mu}" lambda="{_lambda_pick}" emphasis="{_e_pick}" period="{_p_pick}"
           external="{_ext_pick}"
           _onSuccess="mu := mu + 1.0; Done := true" />
  </ReactiveSequence>
</BehaviorTree>

<BehaviorTree ID="Return">
  <Sequence>
    <SubTree ID="GoToObject" Object="/Bill" _autoremap="true"/>
    <SubTree ID="PutDown"    _autoremap="true"/>
  </Sequence>
</BehaviorTree>

<BehaviorTree ID="PutDown">
  <ReactiveSequence>
    <RunOnce> <Script code="_stimuli_put := 1.0"/> </RunOnce>
    <Script code="_lambda_put := (_stimuli_put <= 0.5) ? 0.01 : ((_stimuli_put >= 1.0) ? 1.0 : (0.01 + 0.99*(_stimuli_put - 0.5)/(1.0 - 0.5)));
                  _e_put := mu / _lambda_put;
                  _p_put := 1.0 / _e_put;
                  _ext_put := Done && !Placed" />
    <Place Object="{Object}" Target="ground" knapsack="{knapsack}" stimuli="{_stimuli_put}"
           mu="{mu}" lambda="{_lambda_put}" emphasis="{_e_put}" period="{_p_put}"
           external="{_ext_put}"
           _onSuccess="mu := mu + 1.0; Placed := true" />
  </ReactiveSequence>
</BehaviorTree>

</root>